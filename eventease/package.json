{
  "name": "eventease",
  "version": "1.0.0",
  "private": true,
  "description": "A thoughtful event discovery and planning workspace.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "seed": "node scripts/seed.js",
    "check": "find src public/js tests scripts -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "bcryptjs": "^3.0.2",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "mongoose": "^8.18.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
